# --- Required: your logged-in X session (see README for how to copy these) ---
# Treat these like a password. Never commit the real .env file.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# --- Optional ---
# Handle to unfollow from. Auto-detected from the logged-in session if empty.
# TWITTER_USERNAME=

# Handles to NEVER unfollow (comma separated, with or without @).
# KEEP=friend1,@friend2
# Or one handle per line in a file (inside the container: put it in the mounted /data dir).
# KEEP_FILE=/data/keep.txt

# List who WOULD be unfollowed, without unfollowing anyone.
# DRY_RUN=true

# --- Pacing (defaults are deliberately conservative) ---
# Random pause between unfollows, seconds.
# DELAY_MIN_SEC=15
# DELAY_MAX_SEC=45
# Longer pause after every N unfollows, seconds.
# BURST_SIZE=20
# BURST_PAUSE_MIN_SEC=180
# BURST_PAUSE_MAX_SEC=360
# Hard caps over rolling windows (survive restarts via the /data volume).
# MAX_PER_HOUR=40
# MAX_PER_DAY=250
# Stop after this many unfollows in this run (0 = no limit).
# MAX_TOTAL=0

# --- Rate-limit backoff ---
# First wait after a 429 / "limit reached" response; doubles each time (capped at 4h).
# BACKOFF_BASE_SEC=900
# Give up (exit code 2) after this many consecutive rate-limit hits with no success in between.
# MAX_BACKOFFS=5
